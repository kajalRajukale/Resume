# Shared look for every tape: `Source vhs/_style.tape` right after the Output lines.
Set Shell "bash"
Set FontFamily "JetBrains Mono, JetBrainsMonoNL Nerd Font, monospace"
Set FontSize 18
Set Width 1200
Set Height 630
Set Padding 26
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 45ms
Set CursorBlink false
